<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vernis — студия маникюра в Баку</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap');

  :root{
    --ivory:#FAF5F0;
    --paper:#FFFFFF;
    --espresso:#241A1C;
    --ink-soft:#7C6B6D;
    --wine:#7C2D3E;
    --line:#EBDEDD;
    --accent:#7C2D3E;
    --accent-soft:#F3DEE1;
    --gold:#B08A2E;
    --radius:18px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ivory);
    color:var(--espresso);
    font-family:'Manrope',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces',serif;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  a{color:inherit;}
  .wrap{max-width:1080px; margin:0 auto; padding:0 28px;}

  /* NAV */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(250,245,240,0.88);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{
    display:flex; align-items:center; justify-content:space-between;
    height:72px;
  }
  .logo{
    font-family:'Fraunces',serif;
    font-size:22px; font-weight:700;
    display:flex; align-items:center; gap:8px;
  }
  .logo .dot{width:9px;height:9px;border-radius:50%; background:var(--accent); transition:background .3s;}
  .nav-links{display:flex; gap:32px; font-size:14.5px; font-weight:600;}
  .nav-links a{text-decoration:none; opacity:.75; transition:opacity .2s;}
  .nav-links a:hover{opacity:1;}
  .nav-cta{
    background:var(--accent); color:#fff;
    padding:11px 20px; border-radius:100px;
    font-size:14px; font-weight:700;
    text-decoration:none; transition:transform .2s, background .3s;
    border:none; cursor:pointer;
  }
  .nav-cta:hover{transform:translateY(-2px);}

  /* HERO */
  .hero{
    padding:88px 0 60px;
    position:relative;
    overflow:hidden;
  }
  .hero .wrap{
    display:grid; grid-template-columns:1.15fr 0.85fr; gap:56px; align-items:center;
  }
  .eyebrow{
    font-size:12.5px; font-weight:700; letter-spacing:.14em; text-transform:uppercase;
    color:var(--accent); margin-bottom:18px; transition:color .3s;
    display:flex; align-items:center; gap:8px;
  }
  .eyebrow::before{content:''; width:22px; height:1.5px; background:var(--accent); transition:background .3s;}
  .hero h1{
    font-size:52px; line-height:1.04; letter-spacing:-0.02em;
    margin-bottom:22px;
  }
  .hero h1 em{
    font-style:italic; color:var(--accent); transition:color .3s;
  }
  .hero p.lead{
    font-size:16.5px; color:var(--ink-soft); line-height:1.65; max-width:440px; margin-bottom:32px;
  }
  .hero-ctas{display:flex; gap:14px; align-items:center; margin-bottom:44px;}
  .btn-primary{
    background:var(--accent); color:#fff; border:none;
    padding:15px 26px; border-radius:100px;
    font-size:14.5px; font-weight:700; cursor:pointer;
    transition:transform .2s, background .3s;
    font-family:'Manrope',sans-serif;
  }
  .btn-primary:hover{transform:translateY(-2px);}
  .btn-ghost{
    padding:15px 22px; border-radius:100px;
    border:1.5px solid var(--line); background:transparent;
    font-size:14.5px; font-weight:700; cursor:pointer; color:var(--espresso);
    text-decoration:none;
  }

  /* Swatch strip - signature element */
  .swatch-block{
    font-size:12.5px; color:var(--ink-soft); font-weight:600;
  }
  .swatch-label{margin-bottom:10px;}
  .swatches{display:flex; gap:10px;}
  .swatch{
    width:34px; height:34px; border-radius:50%;
    cursor:pointer; border:2.5px solid var(--paper);
    box-shadow:0 0 0 1.5px var(--line);
    transition:transform .18s ease, box-shadow .18s ease;
    position:relative;
  }
  .swatch:hover{transform:translateY(-3px) scale(1.08);}
  .swatch.active{box-shadow:0 0 0 2px var(--paper), 0 0 0 3.5px var(--accent-swatch, var(--accent));}

  .hero-visual{
    position:relative;
    aspect-ratio:0.85;
    border-radius:28px;
    background:linear-gradient(155deg, var(--accent-soft), var(--paper) 60%);
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
    transition:background .4s;
  }
  .hero-visual .hand-emoji{font-size:120px; filter:saturate(1.05);}
  .float-card{
    position:absolute; background:var(--paper); border-radius:14px;
    padding:12px 16px; box-shadow:0 14px 30px -12px rgba(36,26,28,0.25);
    font-size:12.5px; font-weight:700; display:flex; align-items:center; gap:8px;
  }
  .float-card.a{top:14%; left:8%;}
  .float-card.b{bottom:12%; right:8%;}
  .float-card .price-tag{color:var(--gold);}

  /* SECTION HEADS */
  .section{padding:88px 0;}
  .section-head{margin-bottom:44px; max-width:560px;}
  .section-head .eyebrow{margin-bottom:14px;}
  .section-head h2{font-size:34px; line-height:1.12;}

  /* SERVICES */
  .services-grid{
    display:grid; grid-template-columns:repeat(2, 1fr); gap:1px;
    background:var(--line); border:1px solid var(--line); border-radius:var(--radius);
    overflow:hidden;
  }
  .service-row{
    background:var(--paper); padding:24px 26px;
    display:flex; justify-content:space-between; align-items:center; gap:16px;
    transition:background .2s;
  }
  .service-row:hover{background:var(--accent-soft);}
  .service-row .s-name{font-weight:700; font-size:15px; margin-bottom:4px;}
  .service-row .s-dur{font-size:12.5px; color:var(--ink-soft);}
  .service-row .s-price{
    font-family:'Fraunces',serif; font-weight:600; font-size:19px; color:var(--gold);
    white-space:nowrap;
  }


  /* BOOKING WIDGET */
  .booking{
    background:var(--espresso); color:#fff; border-radius:28px;
    padding:52px;
  }
  .booking .section-head h2{color:#fff;}
  .booking .section-head p{color:#C9BABB; font-size:14.5px; margin-top:10px;}
  .steps-nav{display:flex; gap:8px; margin-bottom:34px;}
  .step-pill{
    flex:1; height:4px; border-radius:4px; background:rgba(255,255,255,0.15);
    position:relative; overflow:hidden;
  }
  .step-pill.done, .step-pill.active{background:var(--accent-swatch, var(--accent));}
  .step-labels{display:flex; justify-content:space-between; font-size:11.5px; color:#B7A6A8; margin-bottom:30px; font-weight:600; letter-spacing:.02em;}
  .step-labels span.on{color:#fff;}

  .option-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:12px;}
  .option-grid.wide{grid-template-columns:repeat(3,1fr);}
  .opt{
    background:rgba(255,255,255,0.05); border:1.5px solid rgba(255,255,255,0.12);
    border-radius:14px; padding:16px 18px; text-align:left; cursor:pointer;
    color:#fff; font-family:'Manrope',sans-serif; transition:all .18s ease;
  }
  .opt:hover{border-color:rgba(255,255,255,0.35); background:rgba(255,255,255,0.09);}
  .opt.selected{
    border-color:var(--accent-swatch, var(--accent));
    background:var(--accent-swatch, var(--accent));
  }
  .opt .opt-name{font-weight:700; font-size:14px; margin-bottom:3px;}
  .opt .opt-meta{font-size:12px; color:#C9BABB;}
  .opt.selected .opt-meta{color:rgba(255,255,255,0.85);}
  .opt .opt-price{color:var(--gold); font-weight:700; font-size:12.5px; margin-top:6px;}
  .opt.selected .opt-price{color:#FFE9B0;}

  .step-panel{min-height:230px;}
  .step-actions{display:flex; justify-content:space-between; align-items:center; margin-top:32px;}
  .link-btn{background:none; border:none; color:#C9BABB; font-weight:700; font-size:13.5px; cursor:pointer;}
  .link-btn:disabled{opacity:.3; cursor:default;}
  .btn-next{
    background:#fff; color:var(--espresso); border:none; padding:14px 30px;
    border-radius:100px; font-weight:700; font-size:14px; cursor:pointer;
    transition:transform .2s;
  }
  .btn-next:disabled{opacity:.35; cursor:default;}
  .btn-next:not(:disabled):hover{transform:translateY(-2px);}

  .summary-box{
    background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.14);
    border-radius:16px; padding:24px; margin-bottom:20px;
  }
  .summary-row{display:flex; justify-content:space-between; padding:9px 0; font-size:14px; border-bottom:1px solid rgba(255,255,255,0.08);}
  .summary-row:last-child{border:none;}
  .summary-row .label{color:#C9BABB;}
  .summary-row .val{font-weight:700;}
  .total-row{display:flex; justify-content:space-between; align-items:baseline; padding-top:14px;}
  .total-row .t-label{font-size:13px; color:#C9BABB; font-weight:600;}
  .total-row .t-val{font-family:'Fraunces',serif; font-size:30px; color:var(--gold); font-weight:600;}

  .contact-fields{display:flex; flex-direction:column; gap:12px; margin-top:18px;}
  .contact-fields input{
    background:rgba(255,255,255,0.06); border:1.5px solid rgba(255,255,255,0.15);
    border-radius:12px; padding:14px 16px; color:#fff; font-family:'Manrope',sans-serif; font-size:14px;
  }
  .contact-fields input::placeholder{color:#8E7C7E;}
  .contact-fields input:focus{outline:none; border-color:var(--accent-swatch, var(--accent));}

  .success-panel{text-align:center; padding:30px 10px;}
  .success-icon{
    width:64px; height:64px; border-radius:50%; margin:0 auto 20px;
    background:var(--accent-swatch, var(--accent)); display:flex; align-items:center; justify-content:center;
    font-size:28px;
  }
  .success-panel h3{color:#fff; font-size:22px; margin-bottom:10px;}
  .success-panel p{color:#C9BABB; font-size:14px; line-height:1.6; max-width:340px; margin:0 auto 24px;}

  /* FOOTER */
  footer{
    border-top:1px solid var(--line); padding:44px 0; margin-top:20px;
  }
  footer .wrap{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;}
  footer .f-info{font-size:13px; color:var(--ink-soft); line-height:1.8;}
  footer .f-info b{color:var(--espresso);}

  @media (max-width:860px){
    .hero .wrap{grid-template-columns:1fr;}
    .hero-visual{order:-1; aspect-ratio:1.4;}
    .hero h1{font-size:38px;}
    .services-grid{grid-template-columns:1fr;}
    .option-grid, .option-grid.wide{grid-template-columns:repeat(2,1fr);}
    .booking{padding:30px 20px; border-radius:20px;}
    .nav-links{display:none;}
  }
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <div class="logo"><span class="dot"></span>Vernis</div>
    <div class="nav-links">
      <a href="#services">Услуги</a>
      <a href="#booking">Запись</a>
    </div>
    <button class="nav-cta" onclick="document.getElementById('booking').scrollIntoView()">Записаться</button>
  </div>
</nav>

<section class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow">Студия маникюра · Баку</div>
      <h1>Ногти — это <em>деталь</em>,<br>которая решает</h1>
      <p class="lead">Аккуратный маникюр, стойкое покрытие и удобная онлайн-запись без звонков. Онлайн-запись за 40 секунд — без звонков.</p>
      <div class="hero-ctas">
        <button class="btn-primary" onclick="document.getElementById('booking').scrollIntoView()">Выбрать время</button>
        <a href="#services" class="btn-ghost">Смотреть цены</a>
      </div>
      <div class="swatch-block">
        <div class="swatch-label">Оттенок сезона — выберите, чтобы примерить на сайт</div>
        <div class="swatches" id="swatches"></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hand-emoji">💅</div>
      <div class="float-card a">✨ Гель-лак <span class="price-tag">35 AZN</span></div>
      <div class="float-card b">⭐ 4.9 · 860 отзывов</div>
    </div>
  </div>
</section>

<section class="section" id="services">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Прайс-лист</div>
      <h2>Честные цены,<br>без скрытых доплат</h2>
    </div>
    <div class="services-grid" id="services-grid"></div>
  </div>
</section>
<section class="section" id="booking">
  <div class="wrap">
    <div class="booking">
      <div class="section-head">
        <div class="eyebrow" style="color:#fff;">Онлайн-запись</div>
        <h2>Забронируйте визит</h2>
        <p>Три шага — и время закреплено за вами.</p>
      </div>

      <div class="steps-nav" id="steps-nav"></div>
      <div class="step-labels" id="step-labels"></div>

      <div class="step-panel" id="step-panel"></div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="logo"><span class="dot"></span>Vernis</div>
    <div class="f-info">
      <span id="contacts"><b>Адрес:</b> ул. Низами 45, Баку &nbsp;·&nbsp; <b>Тел:</b> +994 XX XXX XX XX</span> &nbsp;·&nbsp; <a id="privacy" href="#">Политика конфиденциальности</a>
    </div>
  </div>
</footer>

<script>
/* ---------- Signature interaction ---------- */
const SWATCHES = [
  {name:'Вино', hex:'#7C2D3E', soft:'#F3DEE1'},
  {name:'Терракота', hex:'#B85C38', soft:'#F5E0D4'},
  {name:'Пудра', hex:'#C97B8B', soft:'#F7E3E7'},
  {name:'Слива', hex:'#5B3A5C', soft:'#E9DDE9'},
  {name:'Изумруд', hex:'#3F6B52', soft:'#DCE9E1'},
];
const swatchWrap = document.getElementById('swatches');
SWATCHES.forEach((s, i)=>{
  const el = document.createElement('div');
  el.className = 'swatch' + (i===0 ? ' active' : '');
  el.style.background = s.hex;
  el.title = s.name;
  el.onclick = ()=>{
    document.documentElement.style.setProperty('--accent', s.hex);
    document.documentElement.style.setProperty('--accent-soft', s.soft);
    document.documentElement.style.setProperty('--accent-swatch', s.hex);
    [...swatchWrap.children].forEach(c=>c.classList.remove('active'));
    el.classList.add('active');
  };
  swatchWrap.appendChild(el);
});

const SERVICES = [
  {id:'classic', name:'Классический маникюр', price:25, duration:40},
  {id:'gel', name:'Маникюр + гель-лак', price:35, duration:70},
  {id:'combo', name:'Аппаратный маникюр', price:30, duration:60},
  {id:'pedicure', name:'Педикюр классический', price:40, duration:80}
];
let LOCALE = 'ru-RU';
let CURRENCY = 'AZN';
let PHONE_PLACEHOLDER = '+994 XX XXX XX XX';
const money = value => `${value} ${CURRENCY}`;
let booking = {service:null, day:null, time:null, name:'', phone:'', step:0, done:false, id:null};

function escapeHtml(value){
  return String(value).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
}
function formatDate(iso){
  const d = new Date(`${iso}T12:00:00`);
  return d.toLocaleDateString(LOCALE,{weekday:'short',day:'numeric',month:'short'}).replace('.', '');
}
function nextDays(){
  const out=[]; const now=new Date();
  for(let i=1;i<=14;i++){
    const d=new Date(now); d.setDate(now.getDate()+i);
    const iso=d.toISOString().slice(0,10);
    out.push({iso,label:formatDate(iso)});
  }
  return out;
}

function loadServices(){
  const grid=document.getElementById('services-grid');
  grid.innerHTML='';
  SERVICES.forEach(s=>{
    const row=document.createElement('div'); row.className='service-row';
    row.innerHTML=`<div><div class="s-name">${escapeHtml(s.name)}</div><div class="s-dur">${s.duration} мин</div></div><div class="s-price">${money(s.price)}</div>`;
    grid.appendChild(row);
  });
  renderStep();
}

const STEP_NAMES=['Услуга','Дата и время','Контакты'];
function renderStepsNav(){
  const nav=document.getElementById('steps-nav'), labels=document.getElementById('step-labels');
  nav.innerHTML=''; labels.innerHTML='';
  STEP_NAMES.forEach((name,i)=>{
    const pill=document.createElement('div');
    pill.className='step-pill'+(i<booking.step?' done':i===booking.step?' active':''); nav.appendChild(pill);
    const lab=document.createElement('span'); lab.textContent=name; if(i<=booking.step) lab.className='on'; labels.appendChild(lab);
  });
}

function loadSlots(day){
  /* Demo slots: no server or real availability is used. */
  const all=['10:00','10:30','11:30','12:00','14:00','14:30','16:00','17:30','18:00'];
  const offset=(new Date(`${day}T12:00:00`).getDay()+booking.service.duration/10)%3;
  return all.filter((_, index)=>index%3!==Math.floor(offset));
}

async function renderStep(){
  renderStepsNav();
  const panel=document.getElementById('step-panel'); panel.innerHTML='';
  if(booking.done){
    panel.innerHTML=`<div class="success-panel"><div class="success-icon">✓</div><h3>Запись принята</h3><p>Заявка №${booking.id}. ${escapeHtml(booking.service.name)}<br>${escapeHtml(formatDate(booking.day))}, ${booking.time} · ${money(booking.service.price)}</p><p style="margin-top:10px">Мы свяжемся с вами для подтверждения визита.</p></div><div style="text-align:center"><button class="btn-next" onclick="resetBooking()">Записаться ещё раз</button></div>`;
    return;
  }
  if(booking.step===0){
    const grid=document.createElement('div'); grid.className='option-grid';
    SERVICES.forEach(s=>{
      const opt=document.createElement('div'); opt.className='opt'+(booking.service?.id===s.id?' selected':'');
      opt.innerHTML=`<div class="opt-name">${escapeHtml(s.name)}</div><div class="opt-meta">${s.duration} мин</div><div class="opt-price">${money(s.price)}</div>`;
      opt.onclick=()=>{booking.service=s; booking.day=null; booking.time=null; renderStep();}; grid.appendChild(opt);
    });
    panel.appendChild(grid); panel.appendChild(actions(false,!booking.service)); return;
  }
  if(booking.step===1){
    const dayLabel=document.createElement('div'); dayLabel.style.cssText='font-size:12px;color:#C9BABB;font-weight:700;margin-bottom:10px'; dayLabel.textContent='Выберите день'; panel.appendChild(dayLabel);
    const dayGrid=document.createElement('div'); dayGrid.className='option-grid wide'; dayGrid.style.marginBottom='24px';
    nextDays().forEach(d=>{ const opt=document.createElement('div'); opt.className='opt'+(booking.day===d.iso?' selected':''); opt.style.textAlign='center'; opt.innerHTML=`<div class="opt-name">${d.label}</div>`; opt.onclick=()=>{booking.day=d.iso;booking.time=null;renderStep()};dayGrid.appendChild(opt); });
    panel.appendChild(dayGrid);
    if(booking.day){
      const timeLabel=document.createElement('div'); timeLabel.style.cssText='font-size:12px;color:#C9BABB;font-weight:700;margin-bottom:10px'; timeLabel.textContent='Доступное время'; panel.appendChild(timeLabel);
      const timeGrid=document.createElement('div'); timeGrid.className='option-grid wide';
      const slots=loadSlots(booking.day);
      slots.forEach(t=>{const opt=document.createElement('div');opt.className='opt'+(booking.time===t?' selected':'');opt.style.textAlign='center';opt.innerHTML=`<div class="opt-name">${t}</div>`;opt.onclick=()=>{booking.time=t;renderStep()};timeGrid.appendChild(opt)});
      panel.appendChild(timeGrid);
    }
    panel.appendChild(actions(true,!(booking.day&&booking.time))); return;
  }
  if(booking.step===2){
    const summary=document.createElement('div'); summary.className='summary-box'; summary.innerHTML=`<div class="summary-row"><span class="label">Услуга</span><span class="val">${escapeHtml(booking.service.name)}</span></div><div class="summary-row"><span class="label">Дата и время</span><span class="val">${escapeHtml(formatDate(booking.day))}, ${booking.time}</span></div><div class="total-row"><span class="t-label">Итого</span><span class="t-val">${money(booking.service.price)}</span></div>`; panel.appendChild(summary);
    const fields=document.createElement('div'); fields.className='contact-fields'; fields.innerHTML=`<input type="text" id="f-name" placeholder="Ваше имя" value="${escapeHtml(booking.name)}"><input type="tel" id="f-phone" placeholder="${escapeHtml(PHONE_PLACEHOLDER)}" value="${escapeHtml(booking.phone)}"><label style="font-size:12px;color:#C9BABB"><input type="checkbox" id="f-consent"> Согласен(на) на обработку номера телефона</label>`; panel.appendChild(fields);
    const nameInput=fields.querySelector('#f-name'), phoneInput=fields.querySelector('#f-phone');
    const actionRow=actions(true,true,'Подтвердить запись'); panel.appendChild(actionRow); const nextBtn=actionRow.querySelector('.btn-next');
    const check=()=>{booking.name=nameInput.value.trim();booking.phone=phoneInput.value.trim();nextBtn.disabled=!(booking.name.length>1&&booking.phone.length>5&&fields.querySelector('#f-consent').checked)};
    nameInput.oninput=check; phoneInput.oninput=check; fields.querySelector('#f-consent').onchange=check; check();
  }
}

function actions(showBack,nextDisabled,nextLabel='Далее'){
  const row=document.createElement('div'); row.className='step-actions';
  const back=document.createElement('button'); back.className='link-btn'; back.textContent='← Назад'; back.disabled=!showBack; back.onclick=()=>{booking.step--;renderStep()};
  const next=document.createElement('button'); next.className='btn-next'; next.textContent=nextLabel; next.disabled=nextDisabled;
  next.onclick=async()=>{
    if(booking.step===2){
      next.disabled=true; next.textContent='Готово';
      booking.id=String(Math.floor(1000 + Math.random()*9000)); booking.done=true;
    }else{booking.step++;}
    renderStep();
  };
  row.appendChild(back); row.appendChild(next); return row;
}
function resetBooking(){booking={service:null,day:null,time:null,name:'',phone:'',step:0,done:false,id:null};renderStep()}
document.getElementById('privacy').href='#';
loadServices();
</script>

