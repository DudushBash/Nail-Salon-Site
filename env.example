# Public URL after deployment. HTTPS is required in production.
PUBLIC_URL=https://demo.example.com

# First administrator account. Change both values before the first launch.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Persistent directory for SQLite. Do not use an ephemeral container path.
DATA_DIR=./data

# Optional: salon notifications in Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: URL of your SMS/WhatsApp provider adapter.
# Vernis posts phone, text, event and cancel_url as JSON.
SMS_WEBHOOK_URL=
